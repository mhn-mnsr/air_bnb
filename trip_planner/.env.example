# LLM provider via LiteLLM in CrewAI.
# Common providers:
# - OpenAI: set OPENAI_API_KEY and TRIP_LLM_MODEL=openai/gpt-4o-mini
# - Groq: set GROQ_API_KEY and TRIP_LLM_MODEL=groq/llama-3.3-70b-versatile
# - Anthropic: set ANTHROPIC_API_KEY and TRIP_LLM_MODEL=anthropic/claude-3-5-sonnet-latest
TRIP_LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=replace_me
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional defaults for quick runs
TRIP_ORIGIN=San Francisco
TRIP_MONTH=June
TRIP_DAYS=7
TRIP_INTERESTS=food, museums, nature
TRIP_BUDGET_USD=3000
